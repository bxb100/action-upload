{
  "name": "upload-action",
  "version": "0.2.2",
  "private": true,
  "description": "Uniform Uploader Github Action",
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "format:write": "oxfmt --write '**/*.ts'",
    "format:check": "oxfmt --check '**/*.ts'",
    "lint": "oxlint src/**/*.ts",
    "local-action": "NODE_OPTIONS=--no-experimental-strip-types NODE_ENV=test npx @github/local-action . src/main.ts .env",
    "download": "node ./script/vendor_opendal.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run typecheck && NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "package": "rimraf dist && npm run build && npm run download",
    "all": "npm test && npm run format:write && npm run lint && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bxb100/action-upload.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Lemon",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/glob": "^0.6.1",
    "opendal": "^0.49.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@swc/core": "^1.15.24",
    "@swc/jest": "^0.2.39",
    "@types/node": "^25.5.0",
    "eslint-plugin-github": "^6.0.0",
    "jest": "^30.3.0",
    "js-yaml": "^4.1.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.8",
    "typescript": "^6.0.2"
  }
}
